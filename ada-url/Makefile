# $NetBSD$

DISTNAME=	ada-4.0.0
PKGNAME=	ada-url-4.0.0
WRKSRC=		${WRKDIR}/ada-4.0.0
CATEGORIES=	www
MASTER_SITES=	${MASTER_SITE_GITHUB:=ada-url/}
GITHUB_PROJECT=	ada
GITHUB_TAG=	v${PKGVERSION_NOREV}

MAINTAINER=	pkgsrc-users@NetBSD.org
HOMEPAGE=	https://github.com/ada-url/ada
COMMENT=	Fast spec-compliant URL parser
LICENSE=	mit

USE_LANGUAGES=		c c++
USE_CXX_FEATURES=	c++20
GCC_REQD+=		14

CMAKE_CONFIGURE_ARGS += -DADA_TESTING=OFF
CMAKE_CONFIGURE_ARGS += -DADA_TOOLS=OFF
CMAKE_CONFIGURE_ARGS += -DBUILD_SHARED_LIBS=ON
CMAKE_CONFIGURE_ARGS += -DCACHE_FOUND=OFF
CMAKE_CONFIGURE_ARGS += -DCMAKE_DISABLE_FIND_PACKAGE_Python3=ON

.include "../../devel/cmake/build.mk"
.include "../../mk/bsd.pkg.mk"
