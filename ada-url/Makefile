# $NetBSD$

DISTNAME=	ada-3.4.4
PKGNAME=	ada-url-3.4.4
WRKSRC=		${WRKDIR}/ada-3.4.4
CATEGORIES=	www
MASTER_SITES=	${MASTER_SITE_GITHUB:=ada-url/}
