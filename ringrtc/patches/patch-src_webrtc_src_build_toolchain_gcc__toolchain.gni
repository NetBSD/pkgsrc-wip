+
+        # Add ar to inputs if it's not from $PATH. Some toolchains leave
+        # |ar| empty during toolchain setup, so guard get_path_info() here.
+        if (ar != "" && get_path_info(ar, "file") != ar) {
+          inputs =
+              [ get_path_info(rebase_path(ar, ".", root_out_dir), "abspath") ]
+        }
       }
 
