+      # Redefine link_command on NetBSD: all ld flag in one group
+      if (is_netbsd) {
+        link_command = "$ld $start_group_flag {{ldflags}}${extra_ldflags} -o \"$main_outfile\" @\"$rspfile\" {{solibs}} {{libs}} {{rlibs}} $end_group_flag"
+      }
